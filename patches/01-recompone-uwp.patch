+#if RECOMPONE_UWP
+namespace RecompOne.Runtime.Modding;
+
+// Xbox (UWP + NativeAOT): los mods se compilan con Roslyn y se enganchan con MonoMod, y las dos cosas
+// generan código en tiempo de ejecución, que NativeAOT no admite. Esta versión conserva la API pública
+// de ModLoader (la usan Entry.cs, generado, y el popup de mods) sin cargar nada.
+public sealed class ModEntry
+{
+    public ModInfo Info = null!;
+    public bool Enabled;
+    public bool Loaded;
+    public int HookCount;
+    public byte[]? IconData;
+    public bool HasSettings { get; internal set; }
+    public string? LoadError { get; internal set; }
+
+    public void DrawSettings()
+    {
+    }
+}
+
+public static class ModLoader
+{
+    public static IReadOnlyList<ModEntry> Mods => [];
+
+    public static IReadOnlyList<ModInfo> LoadedMods => [];
+
+    public static string Root { get; private set; } = "";
+
+    public static void LoadAll(string? root = null)
+    {
+        Console.WriteLine("[Mods] mods disabled on this build");
+    }
+
+    public static bool PollChanges()
+    {
+        return false;
+    }
+
+    public static bool Rescan()
+    {
+        return false;
+    }
+
+    public static void SetEnabled(string id, bool enabled)
+    {
+    }
+
+    public static void Reload(string id)
+    {
+    }
+}
+#endif
